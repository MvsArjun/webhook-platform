# Local development only. Replace this placeholder in your untracked .env.
POSTGRES_DB=relay
POSTGRES_USER=relay
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432
# API/worker also need the SAME persistent RELAY_SIGNING_MASTER_KEY; see README.
# Spring does not read this Compose .env file automatically.
# Optional API metrics use a separate RELAY_OPERATIONS_TOKEN and explicit opt-in;
# see docs/OBSERVABILITY.md. Do not reuse customer or signing credentials.

