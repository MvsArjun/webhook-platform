{
  "name": "relay-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test:e2e": "tsc -p tsconfig.e2e.json && node e2e/run.mjs",
    "test:e2e:install": "node e2e/install.mjs",
    "test:bench": "node --check bench/run.mjs && node --test bench/*.test.mjs",
    "bench": "node bench/run.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "pg": "8.23.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
